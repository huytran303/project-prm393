;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_cash" target="cs_out"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="1660" /></Array></mxGeometry></mxCell><mxCell id="e38b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;entryX=0.0286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cs_out" target="join_day"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b_out" value="Check out" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="755" y="1630" width="170" height="50" as="geometry" /></mxCell><mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b_eos" target="b_out"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;entryX=0.6571;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_out" target="join_day"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sv_review" value="Hand over own cash, check out; review shift cash reports" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="975" y="1630" width="170" height="50" as="geometry" /></mxCell><mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sv_eos" target="sv_review"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="join_day" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="380" y="1720" width="700" height="6" as="geometry" /></mxCell><mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;entryX=0.9714;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sv_review" target="join_day"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m_review" value="Review dashboard, reports, handovers and low-stock alerts" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1195" y="1800" width="170" height="62" as="geometry" /></mxCell><mxCell id="sv_count" value="Stocktake: count every ingredient" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="975" y="1890" width="170" height="50" as="geometry" /></mxCell><mxCell id="m_reorder" value="Reorder and stock in received goods" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1195" y="1890" width="170" height="50" as="geometry" /></mxCell><mxCell id="m_end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1266" y="1970" width="28" height="28" as="geometry" /></mxCell><mxCell id="e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="join_day" target="m_review"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="1723" /></Array></mxGeometry></mxCell><mxCell id="e47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_review" target="sv_count"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="1825" /></Array></mxGeometry></mxCell><mxCell id="e48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sv_count" target="m_reorder"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m_reorder" target="m_end"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="org-structure-starbucks" name="Organization Structure (Starbucks reference)"><mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageWidth="900" pageHeight="780" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Starbucks — store-level organization structure (reference model)&lt;/b&gt;" style="text;html=1;fontSize=16;align=center;" vertex="1" parent="1"><mxGeometry x="140" y="20" width="620" height="40" as="geometry" /></mxCell><mxCell id="dm" value="&lt;b&gt;District Manager&lt;/b&gt;&lt;br&gt;Leads a multi-coffeehouse portfolio and is accountable for coffeehouse performance in the district [1]; manages the overall operations of eight to ten stores and the district-wide store management team [3]" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="190" y="70" width="520" height="64" as="geometry" /></mxCell><mxCell id="store" value="One Starbucks coffeehouse" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeWidth=1;fontSize=12;fontStyle=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="140" y="160" width="620" height="410" as="geometry" /></mxCell><mxCell id="sm" value="&lt;b&gt;Store Manager&lt;/b&gt;&lt;br&gt;Runs the coffeehouse “as if it belongs to you”: daily operations, growth of the business, coaching on the sales floor [1]; manages the overall operation of the store, the workforce, financial performance, safety and security [2]" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="190" y="200" width="520" height="76" as="geometry" /></mxCell><mxCell id="asm" value="&lt;b&gt;Assistant Store Manager&lt;/b&gt;&lt;br&gt;Assists the store manager in executing store operations; supervises a team of store partners; ensures customer satisfaction and product quality [2]" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="190" y="300" width="520" height="64" as="geometry" /></mxCell><mxCell id="ss" value="&lt;b&gt;Shift Supervisor&lt;/b&gt; (per shift)&lt;br&gt;Runs shifts, leads the coffeehouse team and makes decisions that impact operations [1]; assists the store manager in executing store operations during shifts and directs partners to their workstations [2]; trained in cash controller responsibilities [2]" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="190" y="390" width="520" height="80" as="geometry" /></mxCell><mxCell id="bar" value="&lt;b&gt;Barista&lt;/b&gt; (1..n per shift)&lt;br&gt;Handcrafts beverages and connects with customers [1]; delivers customer service and provides quality beverages and food products [2]; assigned to a workstation by the shift supervisor [2]" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="190" y="496" width="520" height="64" as="geometry" /></mxCell><mxCell id="cust" value="&lt;b&gt;Customer&lt;/b&gt; (Starbucks Rewards member, external)&lt;br&gt;Orders and pays ahead in the Starbucks app with Mobile Order &amp;amp; Pay and picks the order up in store [7], [8]; earns Stars per amount spent and redeems them for drinks [8], [9]" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;dashed=1;" vertex="1" parent="1"><mxGeometry x="190" y="620" width="520" height="70" as="geometry" /></mxCell><mxCell id="src" value="Sources: [1] Starbucks retail careers; [2] Starbucks Australia careers; [3] Starbucks Indonesia store management careers; [4] Starbucks Germany career page; [7]–[9] see SRS 5.5 References. Accessed 19 Oct 2026." style="text;html=1;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="140" y="710" width="620" height="44" as="geometry" /></mxCell><mxCell id="s0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dm" target="sm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sm" target="asm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="asm" target="ss"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ss" target="bar"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s4" value="serves" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bar" target="cust"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>