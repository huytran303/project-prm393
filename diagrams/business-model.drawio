<mxfile host="app.diagrams.net"><diagram id="org" name="Organization Structure"><mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageWidth="900" pageHeight="880" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" style="text;html=1;fontSize=16;align=center;" value="&lt;b&gt;BrewBoss cafe — organization structure&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;adapted from the Starbucks store-level structure (figure 1-2)&lt;/font&gt;" vertex="1"><mxGeometry x="140" y="20" width="620" height="40" as="geometry" /></mxCell><mxCell id="owner" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Owner / Manager&lt;/b&gt;&lt;br&gt;App role: &lt;i&gt;manager&lt;/i&gt; · phone&lt;br&gt;Reference: Starbucks Store Manager + Assistant Store Manager&lt;br&gt;&lt;br&gt;• Menu, sizes, toppings, recipes&lt;br&gt;• Staff accounts, shift history&lt;br&gt;• Ingredients, stock-in, adjustments&lt;br&gt;• Tables and table QR codes&lt;br&gt;• Vouchers, loyalty settings&lt;br&gt;• Dashboard, reports, order history, shop settings&lt;br&gt;&lt;br&gt;&lt;i&gt;Holds every permission below&lt;/i&gt;" vertex="1"><mxGeometry x="270" y="70" width="360" height="190" as="geometry" /></mxCell><mxCell id="cashier" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Cashier&lt;/b&gt; (1..n per shift)&lt;br&gt;App role: &lt;i&gt;cashier&lt;/i&gt; · counter tablet&lt;br&gt;Reference: Starbucks Barista (counter workstation)&lt;br&gt;&lt;br&gt;• Check in with opening cash&lt;br&gt;• Table map, create orders, takeaway&lt;br&gt;• Confirm / reject customer QR orders&lt;br&gt;• Serve, move / merge tables&lt;br&gt;• Payment: cash, VietQR, split; voucher, loyalty points&lt;br&gt;• Cancel awaiting / pending orders&lt;br&gt;• Check out, cash handover" vertex="1"><mxGeometry x="60" y="500" width="330" height="170" as="geometry" /></mxCell><mxCell id="barista" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Barista&lt;/b&gt; (1..n per shift)&lt;br&gt;App role: &lt;i&gt;barista&lt;/i&gt; · bar tablet&lt;br&gt;Reference: Starbucks Barista (bar workstation)&lt;br&gt;&lt;br&gt;• Check in / out (no cash)&lt;br&gt;• Real-time order queue&lt;br&gt;• Start → Done per order batch&lt;br&gt;• Ready notification to the counter" vertex="1"><mxGeometry x="510" y="500" width="330" height="170" as="geometry" /></mxCell><mxCell id="customer" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;dashed=1;" value="&lt;b&gt;Customer&lt;/b&gt; (external, no staff account)&lt;br&gt;Own phone · anonymous auth&lt;br&gt;Reference: Starbucks Rewards member&lt;br&gt;&lt;br&gt;• Scan table QR, browse menu, self-order&lt;br&gt;• Track order status&lt;br&gt;• Earn / redeem points by phone number" vertex="1"><mxGeometry x="60" y="720" width="330" height="110" as="geometry" /></mxCell><mxCell id="o1" parent="1" edge="1" source="owner" target="supervisor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="o3" parent="1" edge="1" source="cashier" target="customer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;endArrow=open;endFill=0;" value="serves"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="o4" parent="1" edge="1" source="cashier" target="barista" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;startArrow=open;startFill=0;endArrow=open;endFill=0;" value="sends orders / ready"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="supervisor" value="&lt;b&gt;Shift Supervisor&lt;/b&gt; (1 per shift)&lt;br&gt;App role: &lt;i&gt;supervisor&lt;/i&gt; · counter tablet / phone&lt;br&gt;Reference: Starbucks Shift Supervisor&lt;br&gt;&lt;br&gt;• Runs the shift: directs cashiers and baristas&lt;br&gt;• Cancels an order once the bar has started&lt;br&gt;• Stocktake&lt;br&gt;• Reviews the cash report of every shift&lt;br&gt;&lt;br&gt;&lt;i&gt;Also holds every Cashier and Barista permission&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="270" y="300" width="360" height="150" as="geometry" /></mxCell><mxCell id="o5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="supervisor" target="cashier"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="o6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="supervisor" target="barista"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="bmc" name="Business Model Canvas"><mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageWidth="1500" pageHeight="740" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title3" parent="1" style="text;html=1;fontSize=16;align=left;" value="&lt;b&gt;BrewBoss cafe — business model canvas&lt;/b&gt;" vertex="1"><mxGeometry x="40" y="20" width="800" height="30" as="geometry" /></mxCell><mxCell id="kp" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Key partners&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Coffee, milk, tea, syrup suppliers&lt;br&gt;• Banks via VietQR (NAPAS)&lt;br&gt;• Firebase (Google Cloud) for app backend&lt;br&gt;• Landlord / mall (premises)" vertex="1"><mxGeometry x="40" y="70" width="280" height="460" as="geometry" /></mxCell><mxCell id="ka" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Key activities&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Prepare and serve drinks, food&lt;br&gt;• Take orders at counter and via table QR&lt;br&gt;• Buy, receive and count stock&lt;br&gt;• Run shifts and cash handovers&lt;br&gt;• Update menu and run vouchers" vertex="1"><mxGeometry x="320" y="70" width="280" height="230" as="geometry" /></mxCell><mxCell id="kr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Key resources&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Premises, tables with QR codes&lt;br&gt;• Baristas, cashiers, manager&lt;br&gt;• Bar equipment, counter and bar tablets&lt;br&gt;• Recipes and menu data in BrewBoss" vertex="1"><mxGeometry x="320" y="300" width="280" height="230" as="geometry" /></mxCell><mxCell id="vp" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Value propositions&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Fresh drinks, customizable size and toppings&lt;br&gt;• Fast service: order reaches the bar in &amp;lt; 2 s&lt;br&gt;• Self-order from the table, no waiting at counter&lt;br&gt;• Pay by cash or VietQR&lt;br&gt;• Loyalty points and vouchers" vertex="1"><mxGeometry x="600" y="70" width="280" height="460" as="geometry" /></mxCell><mxCell id="cr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Customer relationships&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Self-service via table QR&lt;br&gt;• Loyalty points by phone number&lt;br&gt;• Vouchers for returning customers&lt;br&gt;• Order status on the customer's phone" vertex="1"><mxGeometry x="880" y="70" width="280" height="230" as="geometry" /></mxCell><mxCell id="ch" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Channels&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Walk-in, dine-in at tables&lt;br&gt;• Takeaway at the counter&lt;br&gt;• Table QR menu (web deep link)" vertex="1"><mxGeometry x="880" y="300" width="280" height="230" as="geometry" /></mxCell><mxCell id="cs" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Customer segments&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Students and office workers nearby&lt;br&gt;• Groups meeting / studying (dine-in)&lt;br&gt;• Commuters buying takeaway&lt;br&gt;• Regulars in the loyalty program" vertex="1"><mxGeometry x="1160" y="70" width="280" height="460" as="geometry" /></mxCell><mxCell id="cost" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Cost structure&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Ingredients (tracked by recipe, waste, stocktake)&lt;br&gt;• Staff wages per shift&lt;br&gt;• Rent, utilities, equipment&lt;br&gt;• Vouchers / redeemed points as discounts&lt;br&gt;• Firebase usage (low, free tier for one shop)" vertex="1"><mxGeometry x="40" y="530" width="700" height="180" as="geometry" /></mxCell><mxCell id="rev" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Revenue streams&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Drink and food sales per order (VND)&lt;br&gt;• Paid by cash, VietQR, or split&lt;br&gt;• Upsell: sizes, toppings, add-on items&lt;br&gt;• Repeat visits driven by loyalty" vertex="1"><mxGeometry x="740" y="530" width="700" height="180" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="process-v" name="Business Process (portrait)"><mxGraphModel dx="1400" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="2050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="vtitle" value="&lt;b&gt;BrewBoss cafe — business process (one shop day)&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="36" as="geometry" /></mxCell><mxCell id="ph0" value="1. Set-up" style="rounded=0;html=1;horizontal=0;fillColor=#eeeeee;strokeWidth=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="30" height="310" as="geometry" /></mxCell><mxCell id="ph1" value="2. Open shift" style="rounded=0;html=1;horizontal=0;fillColor=#eeeeee;strokeWidth=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="30" height="100" as="geometry" /></mxCell><mxCell id="ph2" value="3. Serve customers (repeats for every customer)" style="rounded=0;html=1;horizontal=0;fillColor=#eeeeee;strokeWidth=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="30" height="1050" as="geometry" /></mxCell><mxCell id="ph3" value="4. Close shift" style="rounded=0;html=1;horizontal=0;fillColor=#eeeeee;strokeWidth=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="30" height="190" as="geometry" /></mxCell><mxCell id="ph4" value="5. Review &amp; replenish" style="rounded=0;html=1;horizontal=0;fillColor=#eeeeee;strokeWidth=1;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1750" width="30" height="270" as="geometry" /></mxCell><mxCell id="lane0" value="Customer" style="swimlane;html=1;startSize=40;fontSize=14;fontStyle=1;fillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="70" y="60" width="220" height="1960" as="geometry" /></mxCell><mxCell id="lane1" value="Cashier" style="swimlane;html=1;startSize=40;fontSize=14;fontStyle=1;fillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="290" y="60" width="220" height="1960" as="geometry" /></mxCell><mxCell id="lane2" value="BrewBoss app (system)" style="swimlane;html=1;startSize=40;fontSize=14;fontStyle=1;fillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="510" y="60" width="220" height="1960" as="geometry" /></mxCell><mxCell id="lane3" value="Barista" style="swimlane;html=1;startSize=40;fontSize=14;fontStyle=1;fillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="730" y="60" width="220" height="1960" as="geometry" /></mxCell><mxCell id="lane4" value="Shift Supervisor" style="swimlane;html=1;startSize=40;fontSize=14;fontStyle=1;fillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="950" y="60" width="220" height="1960" as="geometry" /></mxCell><mxCell id="lane5" value="Manager" style="swimlane;html=1;startSize=40;fontSize=14;fontStyle=1;fillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1170" y="60" width="220" height="1960" as="geometry" /></mxCell><mxCell id="m_start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1268" y="108" width="24" height="24" as="geometry" /></mxCell><mxCell id="m_first" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1265" y="145" width="30" height="30" as="geometry" /></mxCell><mxCell id="m_setup" value="Set up menu, recipes, tables &amp; QR codes, staff accounts" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1195" y="190" width="170" height="50" as="geometry" /></mxCell><mxCell id="m_stockin" value="Stock in ingredients (qty, cost)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1195" y="255" width="170" height="50" as="geometry" /></mxCell><mxCell id="m_merge0" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1265" y="315" width="30" height="30" as="geometry" /></mxCell><mxCell id="fork_open" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="160" y="412" width="960" height="6" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m_start" target="m_first"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="[not set up]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m_first" target="m_setup"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1b" value="[set up]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_first" target="m_merge0"><mxGeometry relative="1" x="-0.9" as="geometry"><Array as="points"><mxPoint x="1376" y="160" /><mxPoint x="1376" y="330" /></Array><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m_setup" target="m_stockin"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="m_stockin" target="m_merge0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.9844;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_merge0" target="fork_open"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1105" y="330" /></Array></mxGeometry></mxCell><mxCell id="cs_in" value="Check in, enter opening cash" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="315" y="425" width="170" height="50" as="geometry" /></mxCell><mxCell id="b_in" value="Check in" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="755" y="425" width="170" height="50" as="geometry" /></mxCell><mxCell id="sv_in" value="Check in, enter opening cash" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="975" y="425" width="170" height="50" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="fork_open" target="cs_in"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.7083;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="fork_open" target="b_in"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.9375;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="fork_open" target="sv_in"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c_wait" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="165" y="435" width="30" height="30" as="geometry" /></mxCell><mxCell id="c_start" value="Customer arrives" style="shape=mxgraph.sysml.accEvent;flipH=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="105" y="480" width="150" height="40" as="geometry" /></mxCell><mxCell id="fork_arr" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="120" y="540" width="120" height="6" as="geometry" /></mxCell><mxCell id="e6b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.0208;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="fork_open" target="c_wait"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_wait" target="c_start"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6d" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_start" target="fork_arr"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exi