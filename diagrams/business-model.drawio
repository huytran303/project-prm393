<mxfile host="app.diagrams.net"><diagram id="org" name="Organization Structure"><mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageWidth="900" pageHeight="880" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" style="text;html=1;fontSize=16;align=center;" value="&lt;b&gt;BrewBoss cafe — organization structure&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;adapted from the Starbucks store-level structure (figure 1-2)&lt;/font&gt;" vertex="1"><mxGeometry x="140" y="20" width="620" height="40" as="geometry" /></mxCell><mxCell id="owner" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Owner / Manager&lt;/b&gt;&lt;br&gt;App role: &lt;i&gt;manager&lt;/i&gt; · phone&lt;br&gt;Reference: Starbucks Store Manager + Assistant Store Manager&lt;br&gt;&lt;br&gt;• Menu, sizes, toppings, recipes&lt;br&gt;• Staff accounts, shift history&lt;br&gt;• Ingredients, stock-in, adjustments&lt;br&gt;• Tables and table QR codes&lt;br&gt;• Vouchers, loyalty settings&lt;br&gt;• Dashboard, reports, order history, shop settings&lt;br&gt;&lt;br&gt;&lt;i&gt;Holds every permission below&lt;/i&gt;" vertex="1"><mxGeometry x="270" y="70" width="360" height="190" as="geometry" /></mxCell><mxCell id="cashier" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Cashier&lt;/b&gt; (1..n per shift)&lt;br&gt;App role: &lt;i&gt;cashier&lt;/i&gt; · counter tablet&lt;br&gt;Reference: Starbucks Barista (counter workstation)&lt;br&gt;&lt;br&gt;• Check in with opening cash&lt;br&gt;• Table map, create orders, takeaway&lt;br&gt;• Confirm / reject customer QR orders&lt;br&gt;• Serve, move / merge tables&lt;br&gt;• Payment: cash, VietQR, split; voucher, loyalty points&lt;br&gt;• Cancel awaiting / pending orders&lt;br&gt;• Check out, cash handover" vertex="1"><mxGeometry x="60" y="500" width="330" height="170" as="geometry" /></mxCell><mxCell id="barista" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Barista&lt;/b&gt; (1..n per shift)&lt;br&gt;App role: &lt;i&gt;barista&lt;/i&gt; · bar tablet&lt;br&gt;Reference: Starbucks Barista (bar workstation)&lt;br&gt;&lt;br&gt;• Check in / out (no cash)&lt;br&gt;• Real-time order queue&lt;br&gt;• Start → Done per order batch&lt;br&gt;• Ready notification to the counter" vertex="1"><mxGeometry x="510" y="500" width="330" height="170" as="geometry" /></mxCell><mxCell id="customer" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;dashed=1;" value="&lt;b&gt;Customer&lt;/b&gt; (external, no staff account)&lt;br&gt;Own phone · anonymous auth&lt;br&gt;Reference: Starbucks Rewards member&lt;br&gt;&lt;br&gt;• Scan table QR, browse menu, self-order&lt;br&gt;• Track order status&lt;br&gt;• Earn / redeem points by phone number" vertex="1"><mxGeometry x="60" y="720" width="330" height="110" as="geometry" /></mxCell><mxCell id="o1" parent="1" edge="1" source="owner" target="supervisor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="o3" parent="1" edge="1" source="cashier" target="customer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;endArrow=open;endFill=0;" value="serves"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="o4" parent="1" edge="1" source="cashier" target="barista" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;startArrow=open;startFill=0;endArrow=open;endFill=0;" value="sends orders / ready"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="supervisor" value="&lt;b&gt;Shift Supervisor&lt;/b&gt; (1 per shift)&lt;br&gt;App role: &lt;i&gt;supervisor&lt;/i&gt; · counter tablet / phone&lt;br&gt;Reference: Starbucks Shift Supervisor&lt;br&gt;&lt;br&gt;• Runs the shift: directs cashiers and baristas&lt;br&gt;• Cancels an order once the bar has started&lt;br&gt;• Stocktake&lt;br&gt;• Reviews the cash report of every shift&lt;br&gt;&lt;br&gt;&lt;i&gt;Also holds every Cashier and Barista permission&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="270" y="300" width="360" height="150" as="geometry" /></mxCell><mxCell id="o5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="supervisor" target="cashier"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="o6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="supervisor" target="barista"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="process" name="Business Process"><mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageWidth="3120" pageHeight="800" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title2" parent="1" style="text;html=1;fontSize=16;align=left;" value="&lt;b&gt;BrewBoss cafe — business process (one shop day)&lt;/b&gt;" vertex="1"><mxGeometry x="40" y="20" width="800" height="30" as="geometry" /></mxCell><mxCell id="ph0" parent="1" style="rounded=0;html=1;fillColor=#eeeeee;strokeWidth=1;fontSize=11;fontStyle=1;" value="1. Set-up (once)" vertex="1"><mxGeometry x="80" y="60" width="450" height="30" as="geometry" /></mxCell><mxCell id="ph3" parent="1" style="rounded=0;html=1;fillColor=#eeeeee;strokeWidth=1;fontSize=11;fontStyle=1;" value="2. Open shift" vertex="1"><mxGeometry x="530" y="60" width="150" height="30" as="geometry" /></mxCell><mxCell id="ph4" parent="1" style="rounded=0;html=1;fillColor=#eeeeee;strokeWidth=1;fontSize=11;fontStyle=1;" value="3. Serve customers (repeats all day)" vertex="1"><mxGeometry x="680" y="60" width="1500" height="30" as="geometry" /></mxCell><mxCell id="ph14" parent="1" style="rounded=0;html=1;fillColor=#eeeeee;strokeWidth=1;fontSize=11;fontStyle=1;" value="4. Close shift" vertex="1"><mxGeometry x="2180" y="60" width="300" height="30" as="geometry" /></mxCell><mxCell id="ph16" parent="1" style="rounded=0;html=1;fillColor=#eeeeee;strokeWidth=1;fontSize=11;fontStyle=1;" value="5. Review &amp; replenish" vertex="1"><mxGeometry x="2480" y="60" width="600" height="30" as="geometry" /></mxCell><mxCell id="lane0" parent="1" style="swimlane;horizontal=0;html=1;startSize=40;fontSize=12;fontStyle=1;fillColor=#ffffff;" value="Customer" vertex="1"><mxGeometry x="40" y="90" width="3040" height="130" as="geometry" /></mxCell><mxCell id="lane1" parent="1" style="swimlane;horizontal=0;html=1;startSize=40;fontSize=12;fontStyle=1;fillColor=#ffffff;" value="Cashier" vertex="1"><mxGeometry x="40" y="220" width="3040" height="130" as="geometry" /></mxCell><mxCell id="lane2" parent="1" style="swimlane;horizontal=0;html=1;startSize=40;fontSize=12;fontStyle=1;fillColor=#ffffff;" value="Barista" vertex="1"><mxGeometry x="40" y="350" width="3040" height="130" as="geometry" /></mxCell><mxCell id="lane3" parent="1" style="swimlane;horizontal=0;html=1;startSize=40;fontSize=12;fontStyle=1;fillColor=#ffffff;" value="Manager" vertex="1"><mxGeometry x="40" y="480" width="3040" height="130" as="geometry" /></mxCell><mxCell id="lane4" parent="1" style="swimlane;horizontal=0;html=1;startSize=40;fontSize=12;fontStyle=1;fillColor=#ffffff;" value="BrewBoss app (system)" vertex="1"><mxGeometry x="40" y="610" width="3040" height="130" as="geometry" /></mxCell><mxCell id="m_start" parent="1" style="ellipse;html=1;fillColor=#ffffff;strokeWidth=1;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;" value="" vertex="1"><mxGeometry x="137" y="530" width="30" height="30" as="geometry" /></mxCell><mxCell id="m_setup" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;" value="Set up menu, recipes, tables &amp;amp; QR, staff accounts" vertex="1"><mxGeometry x="240" y="513" width="124" height="64" as="geometry" /></mxCell><mxCell id="m_stockin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;" value="Stock in ingredients (qty, cost)" vertex="1"><mxGeometry x="390" y="513" width="124" height="64" as="geometry" /></mxCell><mxCell id="cs_in" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;" value="Check in, enter opening cash" vertex="1"><mxGeometry x="540" y="253" width="124" height="64" as="geometry" /></mxCell><mxCell id="b_in" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;" value="Check in" vertex="1"><mxGeometry x="540" y="383" width="124" height="64" as="geometry" /></mxCell><mxCell id="c_start" parent="1" style="ellipse;html=1;fillColor=#ffffff;strokeWidth=1;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;" value="Arrives" vertex="1"><mxGeometry x="737" y="140" width="30" height="30" as="geometry" /></mxCell><mxCell id="c_order" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;" value="Orders at the counter or scans table QR" vertex="1"><mxGeometry x="840" y="123" width="124" height="64" as="geometry" /></mxCell><mxCell id="cs_order" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;" value="Create order (table / takeaway) or confirm QR order" vertex="1"><mxGeometry x="990" y="253" width="124" height="64" as="geometry" /></mxCell><mxCell id="s_queue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#f5f5f5;dashed=1;fontSize=11;" value="Push order to bar queue in real time" vertex="1"><mxGeometry x="1140" y="643" width="124" height="64" as="geometry" /></mxCell><mxCell id="b_prep" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;" value="Start preparing (Bắt đầu)" vertex="1"><mxGeometry x="1290" y="383" width="124" height="64" as="geometry" /></mxCell><mxCell id="b_ready" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;" value="Finish batch (Xong)" vertex="1"><mxGeometry x="1440" y="383" width="124" height="64" as="geometry" /></mxCell><mxCell id="s_notify" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#f5f5f5;dashed=1;fontSize=11;" value="Notify counter: order ready" vertex="1"><mxGeometry x="1590" y="643" width="124" height="64" as="geometry" /></mxCell><mxCell id="cs_serve" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;" value="Serve at table / hand over takeaway" vertex="1"><mxGeometry x="1740" y="253" width="124" height="64" as="geometry" /></mxCell><mxCell id="c_recv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;" value="Enjoys drinks; may order more" vertex="1"><mxGeometry x="1890" y="123" width="124" height="64" as="geometry" /></mxCell><mxCell id="cs_pay" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;" value="Take payment: cash / VietQR / split; voucher, points" vertex="1"><mxGeometry x="2040" y="253" width="124" height="64" as="geometry" /></mxCell><mxCell id="s_pay" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#f5f5f5;dashed=1;fontSize=11;" value="Deduct stock by recipe, add points, update revenue" vertex="1"><mxGeometry x="2040" y="643" width="124" height="64" as="geometry" /></mxCell><mxCell id="c_end" parent="1" style="ellipse;html=1;fillColor=#000000;strokeWidth=3;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;" value="Leaves" vertex="1"><mxGeometry x="2237" y="140" width="30" height="30" as="geometry" /></mxCell><mxCell id="m_cancel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;" value="Cancel after bar start (reason; waste if made)" vertex="1"><mxGeometry x="1440" y="513" width="124" height="64" as="geometry" /></mxCell><mxCell id="cs_out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;" value="Check out: count drawer, hand over cash" vertex="1"><mxGeometry x="2340" y="253" width="124" height="64" as="geometry" /></mxCell><mxCell id="b_out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;" value="Check out" vertex="1"><mxGeometry x="2190" y="383" width="124" height="64" as="geometry" /></mxCell><mxCell id="s_cash" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#f5f5f5;dashed=1;fontSize=11;" value="Compute expected cash &amp;amp; difference" vertex="1"><mxGeometry x="2340" y="643" width="124" height="64" as="geometry" /></mxCell><mxCell id="s_low" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#f5f5f5;dashed=1;fontSize=11;" value="Low-stock alert" vertex="1"><mxGeometry x="2790" y="643" width="124" height="64" as="geometry" /></mxCell><mxCell id="m_review" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;" value="Review dashboard, reports, shift handovers" vertex="1"><mxGeometry x="2640" y="513" width="124" height="64" as="geometry" /></mxCell><mxCell id="m_count" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;" value="Stocktake; reorder low items" vertex="1"><mxGeometry x="2790" y="513" width="124" height="64" as="geometry" /></mxCell><mxCell id="m_end" parent="1" style="ellipse;html=1;fillColor=#000000;strokeWidth=3;fontSize=10;verticalLabelPosition=bottom;verticalAlign=top;" value="" vertex="1"><mxGeometry x="2987" y="530" width="30" height="30" as="geometry" /></mxCell><mxCell id="e1" parent="1" edge="1" source="m_start" target="m_setup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" parent="1" edge="1" source="m_setup" target="m_stockin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" parent="1" edge="1" source="m_stockin" target="cs_in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="shop opens"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" parent="1" edge="1" source="cs_in" target="cs_order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" parent="1" edge="1" source="c_start" target="c_order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" parent="1" edge="1" source="c_order" target="cs_order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" parent="1" edge="1" source="cs_order" target="s_queue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" parent="1" edge="1" source="s_queue" target="b_prep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8b" parent="1" edge="1" source="b_in" target="b_prep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" parent="1" edge="1" source="b_prep" target="b_ready" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" parent="1" edge="1" source="b_ready" target="s_notify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" parent="1" edge="1" source="s_notify" target="cs_serve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" parent="1" edge="1" source="cs_serve" target="c_recv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" parent="1" edge="1" source="c_recv" target="cs_order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" value="add-on items"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" parent="1" edge="1" source="c_recv" target="cs_pay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value="asks for bill"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" parent="1" edge="1" source="cs_pay" target="s_pay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" parent="1" edge="1" source="cs_pay" target="c_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" parent="1" edge="1" source="b_ready" target="m_cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="customer cancels"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" parent="1" edge="1" source="cs_pay" target="cs_out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;" value="end of shift"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18b" parent="1" edge="1" source="b_ready" target="b_out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;" value="end of shift"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" parent="1" edge="1" source="cs_out" target="s_cash" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" parent="1" edge="1" source="s_cash" target="m_review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e21" parent="1" edge="1" source="s_pay" target="s_low" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" value="stock ≤ min"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e22" parent="1" edge="1" source="s_low" target="m_count" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e23" parent="1" edge="1" source="m_review" target="m_count" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e24" parent="1" edge="1" source="m_count" target="m_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value=""><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="bmc" name="Business Model Canvas"><mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageWidth="1500" pageHeight="740" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title3" parent="1" style="text;html=1;fontSize=16;align=left;" value="&lt;b&gt;BrewBoss cafe — business model canvas&lt;/b&gt;" vertex="1"><mxGeometry x="40" y="20" width="800" height="30" as="geometry" /></mxCell><mxCell id="kp" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Key partners&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Coffee, milk, tea, syrup suppliers&lt;br&gt;• Banks via VietQR (NAPAS)&lt;br&gt;• Firebase (Google Cloud) for app backend&lt;br&gt;• Landlord / mall (premises)" vertex="1"><mxGeometry x="40" y="70" width="280" height="460" as="geometry" /></mxCell><mxCell id="ka" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Key activities&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Prepare and serve drinks, food&lt;br&gt;• Take orders at counter and via table QR&lt;br&gt;• Buy, receive and count stock&lt;br&gt;• Run shifts and cash handovers&lt;br&gt;• Update menu and run vouchers" vertex="1"><mxGeometry x="320" y="70" width="280" height="230" as="geometry" /></mxCell><mxCell id="kr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Key resources&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Premises, tables with QR codes&lt;br&gt;• Baristas, cashiers, manager&lt;br&gt;• Bar equipment, counter and bar tablets&lt;br&gt;• Recipes and menu data in BrewBoss" vertex="1"><mxGeometry x="320" y="300" width="280" height="230" as="geometry" /></mxCell><mxCell id="vp" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Value propositions&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Fresh drinks, customizable size and toppings&lt;br&gt;• Fast service: order reaches the bar in &amp;lt; 2 s&lt;br&gt;• Self-order from the table, no waiting at counter&lt;br&gt;• Pay by cash or VietQR&lt;br&gt;• Loyalty points and vouchers" vertex="1"><mxGeometry x="600" y="70" width="280" height="460" as="geometry" /></mxCell><mxCell id="cr" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Customer relationships&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Self-service via table QR&lt;br&gt;• Loyalty points by phone number&lt;br&gt;• Vouchers for returning customers&lt;br&gt;• Order status on the customer's phone" vertex="1"><mxGeometry x="880" y="70" width="280" height="230" as="geometry" /></mxCell><mxCell id="ch" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Channels&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Walk-in, dine-in at tables&lt;br&gt;• Takeaway at the counter&lt;br&gt;• Table QR menu (web deep link)" vertex="1"><mxGeometry x="880" y="300" width="280" height="230" as="geometry" /></mxCell><mxCell id="cs" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Customer segments&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Students and office workers nearby&lt;br&gt;• Groups meeting / studying (dine-in)&lt;br&gt;• Commuters buying takeaway&lt;br&gt;• Regulars in the loyalty program" vertex="1"><mxGeometry x="1160" y="70" width="280" height="460" as="geometry" /></mxCell><mxCell id="cost" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Cost structure&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Ingredients (tracked by recipe, waste, stocktake)&lt;br&gt;• Staff wages per shift&lt;br&gt;• Rent, utilities, equipment&lt;br&gt;• Vouchers / redeemed points as discounts&lt;br&gt;• Firebase usage (low, free tier for one shop)" vertex="1"><mxGeometry x="40" y="530" width="700" height="180" as="geometry" /></mxCell><mxCell id="rev" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Revenue streams&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Drink and food sales per order (VND)&lt;br&gt;• Paid by cash, VietQR, or split&lt;br&gt;• Upsell: sizes, toppings, add-on items&lt;br&gt;• Repeat visits driven by loyalty" vertex="1"><mxGeometry x="740" y="530" width="700" height="180" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="process-v" name="Business Process (portrait)"><mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageWidth="1260" pageHeight="1820" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="vtitle" parent="1" style="text;html=1;fontSize=18;align=left;" value="&lt;b&gt;BrewBoss cafe — business process (one shop day)&lt;/b&gt;" vertex="1"><mxGeometry x="40" y="10" width="900" height="36" as="geometry" /></mxCell><mxCell id="vph0" parent="1" style="rounded=0;html=1;horizontal=0;fillColor=#eeeeee;strokeWidth=1;fontSize=13;fontStyle=1;" value="1. Set-up" vertex="1"><mxGeometry x="40" y="100" width="30" height="252" as="geometry" /></mxCell><mxCell id="vph3" parent="1" style="rounded=0;html=1;horizontal=0;fillColor=#eeeeee;strokeWidth=1;fontSize=13;fontStyle=1;" value="2. Open shift" vertex="1"><mxGeometry x="40" y="352" width="30" height="84" as="geometry" /></mxCell><mxCell id="vph4" parent="1" style="rounded=0;html=1;horizontal=0;fillColor=#eeeeee;strokeWidth=1;fontSize=13;fontStyle=1;" value="3. Serve customers (repeats all day)" vertex="1"><mxGeometry x="40" y="436" width="30" height="924" as="geometry" /></mxCell><mxCell id="vph15" parent="1" style="rounded=0;html=1;horizontal=0;fillColor=#eeeeee;strokeWidth=1;fontSize=13;fontStyle=1;" value="4. Close shift" vertex="1"><mxGeometry x="40" y="1360" width="30" height="168" as="geometry" /></mxCell><mxCell id="vph17" parent="1" style="rounded=0;html=1;horizontal=0;fillColor=#eeeeee;strokeWidth=1;fontSize=13;fontStyle=1;" value="5. Review &amp;amp; replenish" vertex="1"><mxGeometry x="40" y="1528" width="30" height="252" as="geometry" /></mxCell><mxCell id="vlane0" parent="1" style="swimlane;html=1;startSize=40;fontSize=14;fontStyle=1;fillColor=#ffffff;" value="Customer" vertex="1"><mxGeometry x="70" y="60" width="230" height="1740" as="geometry" /></mxCell><mxCell id="vlane1" parent="1" style="swimlane;html=1;startSize=40;fontSize=14;fontStyle=1;fillColor=#ffffff;" value="Cashier" vertex="1"><mxGeometry x="300" y="60" width="230" height="1740" as="geometry" /></mxCell><mxCell id="vlane2" parent="1" style="swimlane;html=1;startSize=40;fontSize=14;fontStyle=1;fillColor=#ffffff;" value="Barista" vertex="1"><mxGeometry x="530" y="60" width="230" height="1740" as="geometry" /></mxCell><mxCell id="vlane3" parent="1" style="swimlane;html=1;startSize=40;fontSize=14;fontStyle=1;fillColor=#ffffff;" value="Manager" vertex="1"><mxGeometry x="760" y="60" width="230" height="1740" as="geometry" /></mxCell><mxCell id="vlane4" parent="1" style="swimlane;html=1;startSize=40;fontSize=14;fontStyle=1;fillColor=#ffffff;" value="BrewBoss app (system)" vertex="1"><mxGeometry x="990" y="60" width="230" height="1740" as="geometry" /></mxCell><mxCell id="m_start" parent="1" style="ellipse;html=1;fillColor=#ffffff;strokeWidth=1;fontSize=12;verticalLabelPosition=bottom;verticalAlign=top;" value="" vertex="1"><mxGeometry x="860" y="127" width="30" height="30" as="geometry" /></mxCell><mxCell id="m_setup" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" value="Set up menu, recipes, tables &amp;amp; QR, staff accounts" vertex="1"><mxGeometry x="780" y="196" width="190" height="60" as="geometry" /></mxCell><mxCell id="m_stockin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" value="Stock in ingredients (qty, cost)" vertex="1"><mxGeometry x="780" y="280" width="190" height="60" as="geometry" /></mxCell><mxCell id="cs_in" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" value="Check in, enter opening cash" vertex="1"><mxGeometry x="320" y="364" width="190" height="60" as="geometry" /></mxCell><mxCell id="b_in" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" value="Check in" vertex="1"><mxGeometry x="550" y="364" width="190" height="60" as="geometry" /></mxCell><mxCell id="c_start" parent="1" style="ellipse;html=1;fillColor=#ffffff;strokeWidth=1;fontSize=12;verticalLabelPosition=bottom;verticalAlign=top;" value="Arrives" vertex="1"><mxGeometry x="170" y="463" width="30" height="30" as="geometry" /></mxCell><mxCell id="c_order" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" value="Orders at the counter or scans table QR" vertex="1"><mxGeometry x="90" y="532" width="190" height="60" as="geometry" /></mxCell><mxCell id="cs_order" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" value="Create order (table / takeaway) or confirm QR order" vertex="1"><mxGeometry x="320" y="616" width="190" height="60" as="geometry" /></mxCell><mxCell id="s_queue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#f5f5f5;dashed=1;fontSize=13;" value="Push order to bar queue in real time" vertex="1"><mxGeometry x="1010" y="700" width="190" height="60" as="geometry" /></mxCell><mxCell id="b_prep" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" value="Start preparing (Bắt đầu)" vertex="1"><mxGeometry x="550" y="784" width="190" height="60" as="geometry" /></mxCell><mxCell id="b_ready" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" value="Finish batch (Xong)" vertex="1"><mxGeometry x="550" y="868" width="190" height="60" as="geometry" /></mxCell><mxCell id="s_notify" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#f5f5f5;dashed=1;fontSize=13;" value="Notify counter: order ready" vertex="1"><mxGeometry x="1010" y="952" width="190" height="60" as="geometry" /></mxCell><mxCell id="cs_serve" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" value="Serve at table / hand over takeaway" vertex="1"><mxGeometry x="320" y="1036" width="190" height="60" as="geometry" /></mxCell><mxCell id="c_recv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" value="Enjoys drinks; may order more" vertex="1"><mxGeometry x="90" y="1120" width="190" height="60" as="geometry" /></mxCell><mxCell id="cs_pay" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" value="Take payment: cash / VietQR / split; voucher, points" vertex="1"><mxGeometry x="320" y="1204" width="190" height="60" as="geometry" /></mxCell><mxCell id="s_pay" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#f5f5f5;dashed=1;fontSize=13;" value="Deduct stock by recipe, add points, update revenue" vertex="1"><mxGeometry x="1010" y="1288" width="190" height="60" as="geometry" /></mxCell><mxCell id="c_end" parent="1" style="ellipse;html=1;fillColor=#000000;strokeWidth=3;fontSize=12;verticalLabelPosition=bottom;verticalAlign=top;" value="Leaves" vertex="1"><mxGeometry x="170" y="1303" width="30" height="30" as="geometry" /></mxCell><mxCell id="m_cancel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" value="Cancel after bar start (reason; waste if made)" vertex="1"><mxGeometry x="780" y="1036" width="190" height="60" as="geometry" /></mxCell><mxCell id="cs_out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" value="Check out: count drawer, hand over cash" vertex="1"><mxGeometry x="320" y="1372" width="190" height="60" as="geometry" /></mxCell><mxCell id="b_out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" value="Check out" vertex="1"><mxGeometry x="550" y="1288" width="190" height="60" as="geometry" /></mxCell><mxCell id="s_cash" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#f5f5f5;dashed=1;fontSize=13;" value="Compute expected cash &amp;amp; difference" vertex="1"><mxGeometry x="1010" y="1456" width="190" height="60" as="geometry" /></mxCell><mxCell id="s_low" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#f5f5f5;dashed=1;fontSize=13;" value="Low-stock alert" vertex="1"><mxGeometry x="1010" y="1372" width="190" height="60" as="geometry" /></mxCell><mxCell id="m_review" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" value="Review dashboard, reports, shift handovers" vertex="1"><mxGeometry x="780" y="1540" width="190" height="60" as="geometry" /></mxCell><mxCell id="m_count" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=13;" value="Stocktake; reorder low items" vertex="1"><mxGeometry x="780" y="1624" width="190" height="60" as="geometry" /></mxCell><mxCell id="m_end" parent="1" style="ellipse;html=1;fillColor=#000000;strokeWidth=3;fontSize=12;verticalLabelPosition=bottom;verticalAlign=top;" value="" vertex="1"><mxGeometry x="860" y="1723" width="30" height="30" as="geometry" /></mxCell><mxCell id="v1" parent="1" edge="1" source="m_start" target="m_setup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v2" parent="1" edge="1" source="m_setup" target="m_stockin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v3" parent="1" edge="1" source="m_stockin" target="cs_in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" value="shop opens"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v4" parent="1" edge="1" source="cs_in" target="cs_order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v5" parent="1" edge="1" source="c_start" target="c_order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v6" parent="1" edge="1" source="c_order" target="cs_order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v7" parent="1" edge="1" source="cs_order" target="s_queue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v8" parent="1" edge="1" source="s_queue" target="b_prep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v8b" parent="1" edge="1" source="b_in" target="b_prep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v9" parent="1" edge="1" source="b_prep" target="b_ready" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v10" parent="1" edge="1" source="b_ready" target="s_notify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v11" parent="1" edge="1" source="s_notify" target="cs_serve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v12" parent="1" edge="1" source="cs_serve" target="c_recv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v13" parent="1" edge="1" source="c_recv" target="cs_order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;dashed=1;exitX=0.15;exitY=0;entryX=0;entryY=0.5;" value="add-on items"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v14" parent="1" edge="1" source="c_recv" target="cs_pay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" value="asks for bill"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v15" parent="1" edge="1" source="cs_pay" target="s_pay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v16" parent="1" edge="1" source="cs_pay" target="c_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v17" parent="1" edge="1" source="b_ready" target="m_cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;dashed=1;exitX=0.75;exitY=1;entryX=0;entryY=0.5;" value="customer cancels"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v18" parent="1" edge="1" source="cs_pay" target="cs_out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;dashed=1;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" value="end of shift"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v18b" parent="1" edge="1" source="b_ready" target="b_out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;dashed=1;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" value="end of shift"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v19" parent="1" edge="1" source="cs_out" target="s_cash" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v20" parent="1" edge="1" source="s_cash" target="m_review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v21" parent="1" edge="1" source="s_pay" target="s_low" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="stock ≤ min"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v22" parent="1" edge="1" source="s_low" target="m_count" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v23" parent="1" edge="1" source="m_review" target="m_count" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" value=""><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v24" parent="1" edge="1" source="m_count" target="m_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=12;" value=""><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="org-structure-starbucks" name="Organization Structure (Starbucks reference)"><mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageWidth="900" pageHeight="780" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Starbucks — store-level organization structure (reference model)&lt;/b&gt;" style="text;html=1;fontSize=16;align=center;" vertex="1" parent="1"><mxGeometry x="140" y="20" width="620" height="40" as="geometry" /></mxCell><mxCell id="dm" value="&lt;b&gt;District Manager&lt;/b&gt;&lt;br&gt;Leads a multi-coffeehouse portfolio and is accountable for coffeehouse performance in the district [1]; manages the overall operations of eight to ten stores and the district-wide store management team [3]" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="190" y="70" width="520" height="64" as="geometry" /></mxCell><mxCell id="store" value="One Starbucks coffeehouse" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeWidth=1;fontSize=12;fontStyle=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="140" y="160" width="620" height="410" as="geometry" /></mxCell><mxCell id="sm" value="&lt;b&gt;Store Manager&lt;/b&gt;&lt;br&gt;Runs the coffeehouse “as if it belongs to you”: daily operations, growth of the business, coaching on the sales floor [1]; manages the overall operation of the store, the workforce, financial performance, safety and security [2]" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="190" y="200" width="520" height="76" as="geometry" /></mxCell><mxCell id="asm" value="&lt;b&gt;Assistant Store Manager&lt;/b&gt;&lt;br&gt;Assists the store manager in executing store operations; supervises a team of store partners; ensures customer satisfaction and product quality [2]" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="190" y="300" width="520" height="64" as="geometry" /></mxCell><mxCell id="ss" value="&lt;b&gt;Shift Supervisor&lt;/b&gt; (per shift)&lt;br&gt;Runs shifts, leads the coffeehouse team and makes decisions that impact operations [1]; assists the store manager in executing store operations during shifts and directs partners to their workstations [2]; trained in cash controller responsibilities [2]" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="190" y="390" width="520" height="80" as="geometry" /></mxCell><mxCell id="bar" value="&lt;b&gt;Barista&lt;/b&gt; (1..n per shift)&lt;br&gt;Handcrafts beverages and connects with customers [1]; delivers customer service and provides quality beverages and food products [2]; assigned to a workstation by the shift supervisor [2]" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="190" y="496" width="520" height="64" as="geometry" /></mxCell><mxCell id="cust" value="&lt;b&gt;Customer&lt;/b&gt; (Starbucks Rewards member, external)&lt;br&gt;Orders and pays ahead in the Starbucks app with Mobile Order &amp;amp; Pay and picks the order up in store [7], [8]; earns Stars per amount spent and redeems them for drinks [8], [9]" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#ffffff;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;dashed=1;" vertex="1" parent="1"><mxGeometry x="190" y="620" width="520" height="70" as="geometry" /></mxCell><mxCell id="src" value="Sources: [1] Starbucks retail careers; [2] Starbucks Australia careers; [3] Starbucks Indonesia store management careers; [4] Starbucks Germany career page; [7]–[9] see SRS 5.5 References. Accessed 19 Oct 2026." style="text;html=1;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="140" y="710" width="620" height="44" as="geometry" /></mxCell><mxCell id="s0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dm" target="sm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sm" target="asm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="asm" target="ss"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ss" target="bar"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s4" value="serves" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;endArrow=open;endFill=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bar" target="cust"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>